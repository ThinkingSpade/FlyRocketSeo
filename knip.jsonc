{
  "entry": [
    // Detect Tanstack Start Routes
    "cli-auth.ts",
    "src/start.ts",
    "src/router.tsx",
    "src/routes/**/*.ts",
    "src/routes/**/*.tsx",
    // Drizzle config (plugin disabled due to cloudflare:workers import issues)
    "drizzle.config.ts",
    "drizzle-pg.config.ts",
    // DB schema — exports consumed via `import * as schema` / drizzle()
    "src/db/index.ts",
    "src/db/schema.ts",
    "src/db/app.schema.ts",
    "src/db/better-auth-schema.ts",
    "src/db/pg/schema.ts",
    // Standalone CLI/dev scripts, invoked via package.json scripts
    "scripts/**",
    // Complete, working component whose consumer is a deliberately separate,
    // not-yet-started plan (tab wiring + a confirmation banner) -- see
    // docs/superpowers/specs/2026-07-27-local-geo-targeting-design.md's
    // "Implementation order". Wiring it into a tab now would be scope creep
    // this task's own brief explicitly forbids, so it has no importer yet by
    // design, not by accident -- same reasoning as the src/db/schema.ts
    // family above, applied to a public UI entry point instead of a barrel.
    "src/client/features/geo/GeoLocationSelect.tsx",
    // The stagger wrappers over useReveal (which IS wired, into AppPageShell).
    // Still importer-less because staggering means wrapping each section in its
    // own element, and doing that blind across 22 pages would reshuffle the
    // table/chart/grid layouts hanging off those containers. It is the next
    // step's tool, applied per page once the pages can be seen -- same
    // situation as GeoLocationSelect above, no importer by design.
    "src/client/components/Reveal.tsx",
    // Keyword discovery schema: result shape + geo bundle, exported for
    // Tasks 2-10 (merge function, auto-run guard, server service/function,
    // hook, components, page wiring). No importer yet by design, same
    // reasoning as GeoLocationSelect.
    "src/types/schemas/keyword-discovery.ts",
    // Merge function that combines GSC and Labs keyword rows. Task 2 (this
    // task). Has no importer yet by design -- Task 6 (the hook) will consume
    // it, which is a deliberately separate plan per Task 1's brief.
    "src/client/features/trends/mergeKeywordRows.ts",
    // Auto-run guard: the predicate that decides whether to spend money on a
    // paid discovery call. Task 3. Has no importer yet by design -- Task 6
    // (the hook) will consume it.
    "src/client/features/trends/shouldAutoRunDiscovery.ts",
    // Keyword discovery's one paid call + the recorded-run write that stops
    // it firing twice. Task 4. Has no importer yet by design -- Task 5 (the
    // server function) will consume it.
    "src/server/features/keywords/services/keywordDiscovery.ts",
  ],
  "project": [
    "**/*.{js,mjs,ts,tsx}",
    "!src/routeTree.gen.ts",
    "!web/**",
    "!.claude/worktrees/**",
  ],
  "ignore": ["drizzle-prod.config.ts"],
  // Disable Drizzle plugin - it tries to load drizzle.config.ts which imports cloudflare:workers
  "drizzle": false,
  "ignoreDependencies": [
    // Tailwindcss used via @tailwindcss/vite plugin
    "tailwindcss",
    "daisyui",
    // A peer dependency @cloudflare/kumo requires us to install but that we
    // never import directly -- Kumo pulls its Base UI primitives from inside
    // its own modules, so no file here references it and knip cannot see the
    // link. Kumo's other peers (@phosphor-icons/react, echarts) do NOT need an
    // entry: knip resolves those through Kumo itself, and listing them earns a
    // "Remove from ignoreDependencies" hint.
    "@base-ui/react",
    // Spawned by scripts/cross-platform.mjs for the agent dev server.
    "portless",
  ],
}
