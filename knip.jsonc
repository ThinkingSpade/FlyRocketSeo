{
  "entry": [
    // Detect Tanstack Start Routes
    "cli-auth.ts",
    "src/start.ts",
    "src/router.tsx",
    "src/routes/**/*.ts",
    "src/routes/**/*.tsx",
    // Drizzle config (plugin disabled due to cloudflare:workers import issues)
    "drizzle.config.ts",
    "drizzle-pg.config.ts",
    // DB schema — exports consumed via `import * as schema` / drizzle()
    "src/db/index.ts",
    "src/db/schema.ts",
    "src/db/app.schema.ts",
    "src/db/better-auth-schema.ts",
    "src/db/pg/schema.ts",
    // Standalone CLI/dev scripts, invoked via package.json scripts
    "scripts/**",
    // Test-only Worker/provider entrypoints and seed script are loaded by
    // the isolated browser launcher and Vite configuration.
    "e2e/acceptance/worker.ts",
    "e2e/acceptance/gsc-client.ts",
    "e2e/acceptance/seed.ts",
    "e2e/postgres.config.ts",
    "e2e/postgres/**/*.runtime.ts",
    "e2e/postgres/worker-env.ts",
  ],
  "project": [
    "**/*.{js,mjs,ts,tsx}",
    "!src/routeTree.gen.ts",
    "!web/**",
    "!.claude/worktrees/**",
  ],
  "ignore": ["drizzle-prod.config.ts"],
  // Disable Drizzle plugin - it tries to load drizzle.config.ts which imports cloudflare:workers
  "drizzle": false,
  "ignoreDependencies": [
    // Tailwindcss used via @tailwindcss/vite plugin
    "tailwindcss",
    // Spawned by scripts/cross-platform.mjs for the agent dev server.
    "portless",
  ],
}
