{
  "entry": [
    // Detect Tanstack Start Routes
    "cli-auth.ts",
    "src/start.ts",
    "src/router.tsx",
    "src/routes/**/*.ts",
    "src/routes/**/*.tsx",
    // Drizzle config (plugin disabled due to cloudflare:workers import issues)
    "drizzle.config.ts",
    "drizzle-pg.config.ts",
    // DB schema — exports consumed via `import * as schema` / drizzle()
    "src/db/index.ts",
    "src/db/schema.ts",
    "src/db/app.schema.ts",
    "src/db/better-auth-schema.ts",
    "src/db/pg/schema.ts",
    // Standalone CLI/dev scripts, invoked via package.json scripts
    "scripts/**",
    // Complete, working component whose consumer is a deliberately separate,
    // not-yet-started plan (tab wiring + a confirmation banner) -- see
    // docs/superpowers/specs/2026-07-27-local-geo-targeting-design.md's
    // "Implementation order". Wiring it into a tab now would be scope creep
    // this task's own brief explicitly forbids, so it has no importer yet by
    // design, not by accident -- same reasoning as the src/db/schema.ts
    // family above, applied to a public UI entry point instead of a barrel.
    "src/client/features/geo/GeoLocationSelect.tsx",
    // Motion primitives. Complete and self-contained, but deliberately not yet
    // applied to any page: the timing and distance still have to be tuned
    // against the reference site this work is modelled on, and wiring them in
    // with guessed values would mean redoing every call site. Same situation as
    // GeoLocationSelect above -- no importer by design, not by accident.
    "src/client/components/Reveal.tsx",
    "src/client/hooks/useReveal.ts",
  ],
  "project": [
    "**/*.{js,mjs,ts,tsx}",
    "!src/routeTree.gen.ts",
    "!web/**",
    "!.claude/worktrees/**",
  ],
  "ignore": ["drizzle-prod.config.ts"],
  // Disable Drizzle plugin - it tries to load drizzle.config.ts which imports cloudflare:workers
  "drizzle": false,
  "ignoreDependencies": [
    // Tailwindcss used via @tailwindcss/vite plugin
    "tailwindcss",
    "daisyui",
    // A peer dependency @cloudflare/kumo requires us to install but that we
    // never import directly -- Kumo pulls its Base UI primitives from inside
    // its own modules, so no file here references it and knip cannot see the
    // link. Kumo's other peers (@phosphor-icons/react, echarts) do NOT need an
    // entry: knip resolves those through Kumo itself, and listing them earns a
    // "Remove from ignoreDependencies" hint.
    "@base-ui/react",
    // Spawned by scripts/cross-platform.mjs for the agent dev server.
    "portless",
  ],
}
